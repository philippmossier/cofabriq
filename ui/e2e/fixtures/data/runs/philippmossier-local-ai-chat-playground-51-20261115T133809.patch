+
+  it("keeps a title of exactly 42 characters whole", () => {
+    const exact = `${"x".repeat(41)}?`;
+    expect(exact).toHaveLength(42);
+    expect(titleFrom(exact)).toBe(exact);
+    expect(titleFrom(`  ${"x".repeat(20)}\n\n${"y".repeat(20)}? `)).toBe(
